{
  "name": "rinse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A local-first cleaning cycle tracker for iOS and Android.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sync": "npm run build && cap sync",
    "cap:android": "npm run sync && cap open android",
    "cap:ios": "npm run sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "6.2.2",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/ios": "6.2.2",
    "@capacitor/preferences": "6.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
